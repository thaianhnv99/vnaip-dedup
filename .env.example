# vnaip-dedup: no Sota secret or private key is required.
PORT=8787
# Public, non-secret override for local/self-hosted Core JWKS discovery.
# SOTA_CORE_ORIGIN=http://localhost:3651

# --- GĐ3: tool check-duplicates (chạy ở tiến trình WEB) ---
# Luồng 1 đọc MỌI sáng kiến CÙNG type từ Qdrant (hướng A) rồi để model chấm điểm qua
# Gemini; chỉ đọc collection của đúng type được hỏi (ideas / solutions / initiatives).
# Tiến trình web vì vậy cần: QDRANT_URL + QDRANT_COLLECTION_PREFIX (xem GĐ1 bên dưới,
# CÙNG Qdrant và CÙNG tiền tố với worker) + GEMINI_API_KEY + LLM_SCORER_MODEL.
# Không cần khoá embedding vì luồng này không embed.
#
# AI được gọi tool: BẮT BUỘC đặt ít nhất một danh sách. Không đặt danh sách nào thì tool
# trả 403 cho mọi lời gọi (đóng theo mặc định). Chỉ dựa trên claims đã xác thực của Core;
# nhiều giá trị phân tách bằng dấu phẩy; đặt nhiều danh sách thì phải khớp TẤT CẢ (AND).
# Lấy giá trị thật của sub (service account của VNAIP BE) bằng cách bật tạm
# LOG_VERIFIED_CLAIMS=true, cho BE gọi tool một lần rồi đọc log `invocation_accepted`.
# CHECK_DUPLICATES_ALLOWED_SUBS=__sub-cua-service-account-BE__
# CHECK_DUPLICATES_ALLOWED_OIDS=__oid-cua-VNAIP__
# CHECK_DUPLICATES_ALLOWED_WIDS=__wid-cua-VNAIP__
# Cục bộ với scripts/dev-fake-jwks.ts, token giả mang oid=org-dev-test, wid=ws-dev-test,
# sub=user-dev-test, nên đặt ví dụ:
# CHECK_DUPLICATES_ALLOWED_OIDS=org-dev-test
#
# Trần số sáng kiến gửi cho model (mặc định 100, tối đa 500). Vượt trần thì tool trả 503
# CANDIDATE_LIMIT_EXCEEDED thay vì cắt bớt (cắt có thể bỏ sót sáng kiến trùng). Chạm trần
# nghĩa là đã đến lúc chuyển sang hướng B (top-k theo vector); nâng trần thì đo lại thời gian.
# CHECK_DUPLICATES_CANDIDATE_LIMIT=100
# Tổng thời gian cho cả lời gọi (đọc Qdrant + chấm điểm), mặc định 28000ms, nhỏ hơn
# timeoutMs 30000 của tool trong manifest. Đặt giá trị >= timeoutMs của manifest thì Core
# cắt ngang trước và app không kịp trả lỗi có mã.
# CHECK_DUPLICATES_DEADLINE_MS=28000
#
# Model chấm điểm, qua endpoint tương thích OpenAI của Gemini (dùng chung GEMINI_API_KEY và
# GEMINI_BASE_URL với embedding; OPENROUTER_* không còn được đọc). KHÔNG có model mặc định:
# chọn model là quyết định về chi phí và chất lượng.
# Mock chỉ bật khi đặt "true"; không đặt nghĩa là dùng model thật (và tool trả 503
# TOOL_NOT_CONFIGURED nếu thiếu cấu hình), để production không âm thầm chấm bằng mock.
LLM_MOCK_MODE=true
# Chọn model dùng được trên free tier (xem AI Studio). Tên model không có tiền tố "google/" hay
# "models/". `npx tsx scripts/check-gemini.ts` liệt kê model thấy được và thử gọi thật.
# LLM_SCORER_MODEL=gemini-2.5-flash
# Tuỳ chọn: khoá/endpoint RIÊNG cho scorer. Hạn mức free tier tính theo PROJECT chứ không theo
# khoá, nên khoá của project khác có hạn mức riêng, tách khỏi worker embedding. Đã đặt
# LLM_SCORER_BASE_URL thì BẮT BUỘC đặt LLM_SCORER_API_KEY (không rơi về GEMINI_API_KEY, để không
# gửi khoá đó cho host khác).
# LLM_SCORER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_SCORER_API_KEY=__secret__
# Tuỳ chọn: gửi `reasoning_effort` (none | minimal | low | medium | high). Không đặt thì không
# gửi gì và model dùng mức mặc định. Gemini bật thinking mặc định; token suy nghĩ có thể ăn hết
# max_tokens làm output bị cắt (BAD_OUTPUT, detail.reason=truncated). Khi đó đặt "none" (2.5
# Flash cho phép) hoặc "minimal"; Gemini 2.5 Pro và dòng 3 không tắt được thinking (đặt "none"
# sẽ bị từ chối). Giá trị sai thì tool trả 503 TOOL_NOT_CONFIGURED. Chưa gọi thật: chạy
# scripts/check-gemini.ts để xác nhận trước khi deploy.
# LLM_SCORER_REASONING_EFFORT=none
# HẠN MỨC FREE TIER: mỗi lần check tốn ceil(số ứng viên / LLM_SCORER_BATCH_SIZE) request, và
# free tier giới hạn request mỗi phút và mỗi ngày (xem trang rate limit trong AI Studio). Mặc
# định batch 5 là 20 request cho 100 ứng viên, dễ vượt hạn mức và trả 429 (cause RATE_LIMITED).
# Tăng LLM_SCORER_BATCH_SIZE (mỗi lần gọi sinh nhiều token hơn nên chậm hơn; trần token là 250 cho
# mỗi ứng viên) và giảm LLM_SCORER_CONCURRENCY cho khớp hạn mức. Các giá trị mặc định bên dưới đo
# với model khác, CHƯA đo với Gemini; dùng `scripts/check-gemini.ts --burst=N` để thử.
# Số ứng viên mỗi lần gọi model, số lần gọi song song tối đa, trần thời gian mỗi lần gọi,
# và phần nội dung tối đa của mỗi ứng viên đưa vào prompt (kiểm soát token). Các batch chạy
# song song nên thời gian do độ dài đầu ra mỗi lần gọi quyết định: batch nhỏ + đồng thời cao
# thì nhanh hơn (đo thật: batch 10 mất 9-11 giây, batch 5 mất 7,5 giây cho 100 sáng kiến).
# LLM_SCORER_BATCH_SIZE=5
# LLM_SCORER_CONCURRENCY=20
# LLM_SCORER_TIMEOUT_MS=25000
# LLM_SCORER_MAX_CANDIDATE_CHARS=4000

# Tạm thời: ghi claims đã xác thực của mỗi lời gọi hợp lệ (không ghi token) để
# xem claim nào nhận diện được service account của VNAIP BE. Tắt sau khi đã
# ghi nhận xong.
# LOG_VERIFIED_CLAIMS=true

# --- GĐ1: embedding (Gemini) và Qdrant ---
# Hai tiến trình: web (`npm start`) nhận webhook (đẩy job vào Redis, không cần khoá
# Gemini/Qdrant cho việc này) VÀ phục vụ tool check-duplicates (cần Qdrant + Gemini,
# xem GĐ3 ở trên); worker (`npm run start:worker`) cần các khoá này để embed và ghi Qdrant.
# Web và worker phải trỏ CÙNG Qdrant và CÙNG QDRANT_COLLECTION_PREFIX (lệch tiền tố thì web
# đọc collection khác với collection worker ghi, và tool thấy kho rỗng).
# Mock mode chỉ bật khi đặt "true". Không đặt nghĩa là dùng dịch vụ thật (và
# báo lỗi cấu hình nếu thiếu), để production không âm thầm chạy bằng dữ liệu giả.
EMBEDDING_MOCK_MODE=true
# GEMINI_API_KEY=__secret__
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_MODEL=gemini-embedding-001
# gemini-embedding-001 mặc định ra 3072 chiều; app luôn gửi `dimensions` để cắt về số này cho
# khớp collection Qdrant (1536). Đổi số chiều thì phải dùng QDRANT_COLLECTION_PREFIX mới và index
# lại. Đổi MODEL mà giữ số chiều thì collection cũ vẫn ghi được nhưng vector cũ và mới KHÔNG so
# sánh được với nhau (tool check-duplicates hiện chỉ đọc nội dung nên không ảnh hưởng); cần index
# lại toàn bộ trước khi dùng top-k theo vector (hướng B).
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_TIMEOUT_MS=15000
# EMBEDDING_BATCH_SIZE=64

#
# Qdrant chạy bằng Docker trên máy (lệnh chạy ở README, mục "Qdrant local bằng Docker"):
# REST ở cổng 6333. Cổng 6334 là gRPC do Qdrant tự mở kèm, code này KHÔNG dùng.
# Qdrant local KHÔNG cần API key. Để dùng nó, đặt QDRANT_MOCK_MODE=false (hoặc xoá dòng
# này) rồi bỏ comment hai dòng QDRANT_URL và QDRANT_COLLECTION_PREFIX bên dưới.
QDRANT_MOCK_MODE=true
# QDRANT_URL=http://localhost:6333
# Một server Qdrant, BA collection riêng theo type, tên `<tiền tố>_<type>`:
#   vnaip_dedup_dev_ideas, vnaip_dedup_dev_solutions, vnaip_dedup_dev_initiatives
# Ghi, đọc (kiểm tra trùng), reindex và xoá của mỗi type chỉ chạm collection của type đó.
# Mỗi môi trường một tiền tố, ví dụ vnaip_dedup_dev, vnaip_dedup_stg. Chỉ gồm chữ, số, dấu
# gạch ngang và gạch dưới. Đổi embedding model thì dùng tiền tố mới và reindex.
# QDRANT_COLLECTION_PREFIX=vnaip_dedup_dev
# QDRANT_TIMEOUT_MS=10000
# QDRANT_COLLECTION (một collection chung) đã bị thay bằng QDRANT_COLLECTION_PREFIX: biến cũ
# KHÔNG còn được đọc, và còn nó mà thiếu tiền tố thì app báo lỗi cấu hình nêu rõ điều này.
# QDRANT_API_KEY chỉ cần khi QDRANT_URL KHÔNG phải localhost (khi đó còn bắt buộc https):
# QDRANT_API_KEY=__secret__

# Không còn datasetKey (bỏ 2026-11-04): không tách dữ liệu theo workspace, chỉ tách theo type.
# `type` của sáng kiến bắt buộc là ideas, solutions hoặc initiatives (webhook trả 400 nếu khác).
# `id` sáng kiến phải duy nhất trong toàn VNAIP. Gửi lại cùng `id` với type KHÁC tạo bản thứ
# hai ở collection của type mới và KHÔNG xoá bản ở collection của type cũ.

# --- GĐ2: webhook index (VNAIP BE gọi thẳng, không qua Core) và worker ---
# Web và worker là hai tiến trình riêng, dùng CHUNG REDIS_URL, QUEUE_PREFIX, QUEUE_NAME
# (lệch một trong ba thì job nằm đó mà không ai xử lý) và nên cùng INDEX_MAX_ATTEMPTS.
# Web cần: WEBHOOK_HMAC_SECRETS + REDIS_URL (webhook), và QDRANT_* + GEMINI_API_KEY +
# LLM_SCORER_MODEL + CHECK_DUPLICATES_ALLOWED_* (tool).
# Worker cần: REDIS_URL + GEMINI_API_KEY + QDRANT_URL + QDRANT_COLLECTION_PREFIX.
# Secret dùng để KÝ webhook (HMAC-SHA256), không bao giờ gửi qua network. VNAIP BE phải:
#   1. Tính timestamp = epoch giây hiện tại (UTC), số nguyên dạng chuẩn (không số 0
#      đầu dòng, không thập phân/mũ/hex).
#   2. signature = hex(HMAC_SHA256(secret, `${timestamp}.${rawJsonBody}`)), ký trên
#      ĐÚNG bytes sẽ gửi đi.
#   3. Gửi header X-Webhook-Timestamp: <timestamp>, X-Webhook-Signature: sha256=<signature>
#      và Content-Type: application/json (sai content-type trả 415).
# Chống replay: timestamp lệch quá 5 phút so với giờ server bị từ chối, và mỗi chữ ký chỉ
# được nhận MỘT lần trong cửa sổ đó (Redis cho BullMQ, bộ nhớ cho QUEUE_MOCK_MODE); gửi
# lại y nguyên request đã nhận trả 409 DUPLICATE_DELIVERY, còn request enqueue lỗi (503)
# thì gửi lại được. Hai event giống hệt nhau trong cùng một giây có cùng chữ ký, nên bên
# gửi retry nhớ gửi lại với timestamp mới. Chưa chặn được request bị chặn TRƯỚC khi tới
# server rồi mới replay: muốn chặn cả trường hợp đó cần version đơn điệu trong event.
# Chuyển từ WEBHOOK_API_KEYS (x-api-key) sang HMAC: biến cũ KHÔNG còn được đọc và hai cách
# không chạy song song được, nên app và VNAIP BE phải đổi cùng lúc. Thiếu
# WEBHOOK_HMAC_SECRETS thì webhook trả 503 (log nêu rõ nếu còn WEBHOOK_API_KEYS).
# Nhiều secret phân tách bằng dấu phẩy để đổi secret không phải ngừng nhận event.
# Mỗi secret tối thiểu 16 ký tự (không chứa dấu phẩy), nên là chuỗi ngẫu nhiên dài, tạo bằng:
#   openssl rand -hex 32
# VNAIP BE dùng CÙNG chuỗi này làm khoá ký (nguyên chuỗi UTF-8, không giải mã hex).
# Thiếu biến này thì webhook trả 503.
# WEBHOOK_HMAC_SECRETS=__secret__,__secret-moi__
# QUEUE_MOCK_MODE=true dùng hàng đợi trong bộ nhớ: job MẤT khi tiến trình tắt và không
# chia sẻ được giữa hai tiến trình, nên web tự chạy worker trong tiến trình và
# `npm run start:worker` từ chối chế độ này. Chỉ dùng cục bộ. Không đặt nghĩa là
# dùng BullMQ (cần REDIS_URL, nếu thiếu thì web trả 503 ở webhook còn worker thoát
# mã 1). Môi trường hosted PHẢI dùng BullMQ.
QUEUE_MOCK_MODE=true
# Redis tự host của BullMQ: bắt buộc rediss (TLS) trừ localhost. Phải đặt
# maxmemory-policy=noeviction; không dùng chung với Redis cache của BE. AOF đang tắt:
# Redis khởi động lại thì job đang chờ bị mất, BE cần gửi lại event chưa được index.
# REDIS_URL=rediss://<user>:<mật khẩu>@<host>:<port>/<db>
# Mỗi môi trường một tiền tố khoá nếu dùng chung Redis, ví dụ vnaip-dedup-stg.
# QUEUE_PREFIX=vnaip-dedup
# QUEUE_NAME=idea-index
# Job lỗi (tập failed) và job đã xong được giữ bao lâu; job chứa nội dung sáng kiến.
# QUEUE_FAILED_TTL_DAYS=14
# QUEUE_COMPLETED_TTL_SECONDS=3600
# QUEUE_PUBLISH_TIMEOUT_MS=10000
# QUEUE_MAX_JOB_BYTES=2000000
# Retry của worker: số lần thử tối đa và độ trễ (tăng gấp đôi mỗi lần, có trần).
# INDEX_MAX_ATTEMPTS=5
# INDEX_RETRY_BASE_MS=10000
# INDEX_RETRY_MAX_MS=300000

# --- MinIO (kho file của VNAIP) ---
# #TODO: VNAIP chưa có MinIO. Khi có, điền endpoint, bucket, access key và secret
# CHỈ ĐỌC, và chốt định dạng `fileRef` trong event. Worker chưa tải file.
# (Chỉ worker cần các biến MINIO_* khi làm xong phần file.)
# MINIO_ENDPOINT=#TODO
# MINIO_BUCKET=#TODO
# MINIO_ACCESS_KEY=#TODO
# MINIO_SECRET_KEY=#TODO
