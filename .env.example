# vnaip-dedup: không cần Sota secret hay private key.
PORT=8787
# Override công khai (không phải secret) cho JWKS discovery khi tự host Core.
# SOTA_CORE_ORIGIN=http://localhost:3651

# =====================================================================
# Tool check-duplicates (chạy ở tiến trình web)
# Embed input, tìm top-k sáng kiến cùng type gần nhất ở Qdrant (hướng B), rồi cho Gemini chấm điểm.
# Cần GEMINI_API_KEY cho CẢ embed input lẫn chấm điểm.
# =====================================================================

# AI gọi tool phải khớp ít nhất một danh sách dưới đây (khớp hết nếu đặt nhiều),
# dựa trên claims đã xác thực của Core. Không đặt danh sách nào thì tool luôn trả 403.
# Lấy giá trị thật: bật LOG_VERIFIED_CLAIMS=true, cho BE gọi tool một lần, đọc log
# `invocation_accepted` để biết sub/oid/wid thật của service account VNAIP BE.
# CHECK_DUPLICATES_ALLOWED_SUBS=__sub-cua-service-account-BE__
# CHECK_DUPLICATES_ALLOWED_OIDS=__oid-cua-VNAIP__
# CHECK_DUPLICATES_ALLOWED_WIDS=__wid-cua-VNAIP__

# k của top-k: số sáng kiến cùng type GẦN input nhất (theo vector) được gửi cho model chấm
# (mặc định 20, tối đa 100). Sáng kiến ngoài top-k không được model thấy, nên k nhỏ đánh đổi
# nguy cơ bỏ sót sáng kiến trùng ý nhưng diễn đạt rất khác; tăng k nếu ưu tiên không bỏ sót
# (chi phí và độ trễ tăng theo k). Thay cho CHECK_DUPLICATES_CANDIDATE_LIMIT, biến cũ đó
# KHÔNG còn được đọc.
# CHECK_DUPLICATES_TOP_K=20

# Ngưỡng điểm (0..100): chỉ sáng kiến có percent >= ngưỡng được trả về, và model chỉ được yêu cầu
# liệt kê sáng kiến đạt ngưỡng (mặc định 40, theo prompt chấm điểm). Đặt 0 để trả mọi sáng kiến đã chấm
# (hành vi trước đây; cần nếu VNAIP BE vẫn muốn danh sách "top 5 để tham khảo" khi không match nào
# đạt 50, xem docs/vnaip-be-enrich-ket-qua-check-duplicates.md mục 4). Giá trị sai rơi về 40.
# CHECK_DUPLICATES_MIN_SCORE=40

# Tổng thời gian cho một lời gọi tool (embed + tìm ở Qdrant + chấm điểm). Phải NHỎ HƠN
# timeoutMs khai báo trong manifest (mặc định 28000ms so với 30000ms), nếu
# không Core sẽ cắt ngang trước khi app kịp trả lỗi có mã.
# CHECK_DUPLICATES_DEADLINE_MS=28000

# Model chấm điểm, qua endpoint tương thích OpenAI của Gemini. Dùng chung
# GEMINI_API_KEY với embedding (embedding đi API gốc, base URL khác).
# Không có mặc định: chọn model ảnh hưởng chi phí và chất lượng.
# Mock chỉ bật khi đặt "true"; không đặt là dùng model thật (thiếu cấu hình
# thì tool trả 503 TOOL_NOT_CONFIGURED).
LLM_MOCK_MODE=true
# Dùng `npx tsx scripts/check-gemini.ts` để liệt kê model khả dụng và thử gọi
# thật trước khi chọn (Google có thể gỡ model cũ khỏi người dùng mới không báo
# trước, lúc đó app báo 502 SCORING_UNAVAILABLE dù khoá và model vẫn hợp lệ).
# LLM_SCORER_MODEL=__model-name__

# Tuỳ chọn: khoá/endpoint riêng cho scorer (hạn mức free tier tính theo
# project). Đặt LLM_SCORER_BASE_URL thì PHẢI đặt kèm LLM_SCORER_API_KEY.
# LLM_SCORER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_SCORER_API_KEY=__secret__

# Tuỳ chọn: reasoning_effort gửi cho model (none | minimal | low | medium | high).
# Gemini bật thinking mặc định, có thể ăn hết max_tokens làm output bị cắt
# (BAD_OUTPUT truncated) — khi đó thử "none" hoặc "minimal". Mỗi model nhận
# tập giá trị khác nhau; chạy scripts/check-gemini.ts để kiểm trước khi deploy.
# LLM_SCORER_REASONING_EFFORT=none

# Mỗi lần check tốn ceil(số ứng viên / LLM_SCORER_BATCH_SIZE) request; free
# tier giới hạn request/phút và /ngày. Tăng batch size + giảm concurrency nếu
# hay gặp 429 (RATE_LIMITED). Đo lại bằng scripts/check-gemini.ts --burst=N
# trước khi tin các giá trị mặc định dưới đây.
# LLM_SCORER_BATCH_SIZE=5
# LLM_SCORER_CONCURRENCY=20
# LLM_SCORER_TIMEOUT_MS=25000
# LLM_SCORER_MAX_CANDIDATE_CHARS=4000

# Tạm thời: ghi claims đã xác thực của mỗi lời gọi hợp lệ (không ghi token),
# dùng để dò giá trị sub/oid/wid thật. Tắt sau khi lấy được.
# LOG_VERIFIED_CLAIMS=true

# =====================================================================
# Embedding (Gemini) + Qdrant — dùng bởi worker (và bởi web cho tool trên)
# =====================================================================

# Mock chỉ bật khi đặt "true"; không đặt là dùng dịch vụ thật.
EMBEDDING_MOCK_MODE=true
# GEMINI_API_KEY=__secret__
# Embedding gọi API gốc của Gemini (POST {base}/models/{model}:batchEmbedContents,
# khoá ở header x-goog-api-key) — khác endpoint tương thích OpenAI mà scorer dùng.
# Chỉ đặt EMBEDDING_BASE_URL khi đi qua proxy.
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# EMBEDDING_MODEL=gemini-embedding-001
# Web (embed input) và worker (index) PHẢI dùng cùng EMBEDDING_MODEL và EMBEDDING_DIMENSIONS:
# input được so với vector worker đã lưu. Nếu sáng kiến tìm được do model khác index (vector
# giả của scripts/seed-ideas.ts, hoặc vector cũ trước khi đổi model) thì tool trả 502
# CANDIDATES_UNAVAILABLE (log candidates_embedding_model_mismatch) thay vì xếp hạng sai.
# Bỏ qua kiểm này khi EMBEDDING_MOCK_MODE=true.

# gemini-embedding-001 ra 3072 chiều; app luôn cắt về EMBEDDING_DIMENSIONS cho
# khớp collection Qdrant. Đổi số chiều hoặc đổi model thì phải dùng
# QDRANT_COLLECTION_PREFIX mới và index lại toàn bộ (vector cũ/mới không so
# sánh được với nhau).
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_TIMEOUT_MS=15000
# EMBEDDING_BATCH_SIZE=64

# Qdrant local bằng Docker (xem README, mục "Qdrant local bằng Docker"), REST
# cổng 6333 (không dùng gRPC 6334). Để dùng, xoá QDRANT_MOCK_MODE rồi bỏ
# comment hai dòng QDRANT_URL/QDRANT_COLLECTION_PREFIX bên dưới.
QDRANT_MOCK_MODE=true
# QDRANT_URL=http://localhost:6333

# Một server Qdrant, ba collection riêng theo type: <tiền tố>_ideas/_solutions/_initiatives.
# Mỗi môi trường một tiền tố (ví dụ vnaip_dedup_dev, vnaip_dedup_stg); chỉ gồm
# chữ, số, gạch ngang, gạch dưới. Web và worker PHẢI dùng CÙNG tiền tố, nếu
# không web đọc collection khác với collection worker ghi.
# QDRANT_COLLECTION_PREFIX=vnaip_dedup_dev
# QDRANT_TIMEOUT_MS=10000
# QDRANT_API_KEY chỉ cần khi QDRANT_URL không phải localhost (khi đó HTTPS là bắt buộc).
# QDRANT_API_KEY=__secret__

# `type` của sáng kiến bắt buộc là ideas, solutions hoặc initiatives. `id` phải
# duy nhất toàn VNAIP; gửi lại cùng id với type khác sẽ tạo bản ghi thứ hai ở
# collection mới, không xoá bản ghi ở collection cũ.

# =====================================================================
# Webhook index + hàng đợi (BullMQ/Redis) — web enqueue, worker xử lý
# =====================================================================

# VNAIP BE gọi thẳng webhook này (không qua Core). Ký bằng HMAC-SHA256:
#   1. timestamp = epoch giây hiện tại (UTC), số nguyên chuẩn.
#   2. signature = hex(HMAC_SHA256(secret, `${timestamp}.${rawJsonBody}`)).
#   3. Header: X-Webhook-Timestamp, X-Webhook-Signature: sha256=<signature>,
#      Content-Type: application/json.
# Chống replay: lệch quá 5 phút so với giờ server bị từ chối; mỗi chữ ký chỉ
# dùng được một lần (gửi lại y nguyên trả 409 DUPLICATE_DELIVERY). Nhiều secret
# phân tách bằng dấu phẩy để xoay secret không phải ngừng nhận event. Mỗi
# secret tối thiểu 16 ký tự, tạo bằng: openssl rand -hex 32
# Thiếu biến này thì webhook trả 503.
# WEBHOOK_HMAC_SECRETS=__secret__,__secret-moi__

# Web và worker là hai tiến trình riêng, PHẢI dùng CHUNG REDIS_URL, QUEUE_PREFIX,
# QUEUE_NAME (lệch một trong ba thì job nằm im, không ai xử lý).
# QUEUE_MOCK_MODE=true chỉ dùng cục bộ: hàng đợi trong bộ nhớ, mất job khi tắt
# tiến trình, không chia sẻ được giữa hai tiến trình (`start:worker` từ chối
# chế độ này). Môi trường hosted PHẢI dùng BullMQ thật (đặt REDIS_URL).
QUEUE_MOCK_MODE=true
# Redis tự host riêng cho queue này (không dùng chung với Redis cache của BE),
# bắt buộc maxmemory-policy=noeviction và rediss:// (TLS) trừ khi host là
# localhost. AOF đang tắt: Redis khởi động lại thì job đang chờ bị mất, BE cần
# gửi lại event chưa thấy trong Qdrant.
# REDIS_URL=rediss://<user>:<mat-khau>@<host>:<port>/<db>
# Tiền tố khoá Redis, đổi nếu nhiều môi trường dùng chung một Redis.
# QUEUE_PREFIX=vnaip-dedup
# QUEUE_NAME=idea-index
# Thời gian giữ job lỗi / job đã xong (job chứa nội dung sáng kiến).
# QUEUE_FAILED_TTL_DAYS=14
# QUEUE_COMPLETED_TTL_SECONDS=3600
# QUEUE_PUBLISH_TIMEOUT_MS=10000
# QUEUE_MAX_JOB_BYTES=2000000

# Retry của worker: số lần thử tối đa, độ trễ tăng gấp đôi mỗi lần (có trần).
# Nên khớp giữa web và worker.
# INDEX_MAX_ATTEMPTS=5
# INDEX_RETRY_BASE_MS=10000
# INDEX_RETRY_MAX_MS=300000

# =====================================================================
# MinIO (kho file của VNAIP) — chưa triển khai
# =====================================================================
# #TODO: VNAIP chưa có MinIO. Khi có, điền endpoint/bucket/access key/secret
# CHỈ ĐỌC, và chốt định dạng fileRef trong event. Chỉ worker cần các biến này.
# MINIO_ENDPOINT=#TODO
# MINIO_BUCKET=#TODO
# MINIO_ACCESS_KEY=#TODO
# MINIO_SECRET_KEY=#TODO
